{
  "name": "@yanbobo/gis-sdk",
  "version": "0.1.0-alpha.0",
  "description": "Framework-neutral GIS SDK with a Cesium adapter",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanbobo-ONE/gis-sdk.git"
  },
  "homepage": "https://github.com/yanbobo-ONE/gis-sdk#readme",
  "bugs": {
    "url": "https://github.com/yanbobo-ONE/gis-sdk/issues"
  },
  "keywords": [
    "cesium",
    "gis",
    "sdk",
    "3d-map"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gis-sdk-copy-assets": "./dist/copy-cesium-assets.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./cesium": {
      "import": {
        "types": "./dist/cesium.d.ts",
        "default": "./dist/cesium.js"
      },
      "require": {
        "types": "./dist/cesium.d.cts",
        "default": "./dist/cesium.cjs"
      }
    },
    "./layers": {
      "import": {
        "types": "./dist/layers.d.ts",
        "default": "./dist/layers.js"
      },
      "require": {
        "types": "./dist/layers.d.cts",
        "default": "./dist/layers.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "./dist/styles.css"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "tsup --watch",
    "build": "pnpm clean && tsup && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:api": "typedoc --options typedoc.json",
    "docs:dev": "pnpm docs:api && vitepress dev docs",
    "docs:build": "pnpm docs:api && vitepress build docs",
    "example:prepare": "pnpm build && node scripts/prepare-vanilla-consumer.mjs",
    "example:build": "pnpm example:prepare && npm --prefix .tmp/vanilla-consumer run build",
    "pack:check": "pnpm build && publint && attw --pack --profile node16 --exclude-entrypoints ./styles.css && npm pack --dry-run",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "@types/geojson": "7946.0.16",
    "cesium": "1.144.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.0",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "publint": "0.3.23",
    "tsup": "8.5.1",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitepress": "1.6.4",
    "vitest": "4.1.10"
  }
}
