{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["node", "vitest/globals"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "paths": {
      "@yanbobo/gis-sdk": ["./src/index.ts"],
      "@yanbobo/gis-sdk/core": ["./src/entries/core.ts"],
      "@yanbobo/gis-sdk/cesium": ["./src/entries/cesium.ts"],
      "@yanbobo/gis-sdk/layers": ["./src/entries/layers.ts"]
    },
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "examples/**/*.ts",
    "docs/**/*.ts",
    "docs/**/*.mts",
    "docs/.vitepress/**/*.ts",
    "docs/.vitepress/**/*.mts",
    "*.config.ts"
  ],
  "exclude": ["dist", "coverage", "docs/api"]
}
