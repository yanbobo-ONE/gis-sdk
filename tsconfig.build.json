{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [],
    "ignoreDeprecations": "6.0",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
